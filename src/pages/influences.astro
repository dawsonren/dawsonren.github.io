---
import Base from '../layouts/Base.astro';

// Each line says what I took from the work — never who I know. Bodies are Dawson's to write;
// until then, dev builds show a visible TODO marker and production shows the name only.
const showTodo = import.meta.env.DEV;
---

<Base
  title="Influences"
  description="Influences: a short list of people whose work shaped how Dawson Ren thinks about models, decisions, and operations, and what he took from each of them."
>
  <div class="wrap page">
    <h1>Influences</h1>
    <p class="intro muted">
      A short list of people whose work shaped how I think about this. Some I've worked with;
      most I've only read.
    </p>

    <ul class="rows">
      <li>
        <h2>Laura Albert</h2>
        <p class="muted">
          <!-- TODO: one or two sentences, what you took from the work -->
          {showTodo && <span class="todo">TODO</span>}
        </p>
      </li>
      <li>
        <h2>Ben Recht</h2>
        <p class="muted">
          <!-- TODO: one or two sentences, what you took from the work -->
          {showTodo && <span class="todo">TODO</span>}
        </p>
      </li>
      <li>
        <h2>Mike Watson</h2>
        <p class="muted">
          <!-- TODO: one or two sentences, what you took from the work -->
          {showTodo && <span class="todo">TODO</span>}
        </p>
      </li>
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(var(--s-6), 5vw, var(--s-8));
  }

  .intro {
    margin-top: var(--s-4);
    max-width: 60ch;
  }

  .rows {
    list-style: none;
    padding: 0;
    margin-top: var(--s-7);
    border-top: 1px solid var(--rule);
  }

  .rows li {
    display: grid;
    gap: var(--s-2) var(--s-6);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 720px) {
    .rows li {
      grid-template-columns: 200px 1fr;
      align-items: baseline;
    }
  }

  h2 {
    font-size: var(--fs-h3);
  }

  .rows p {
    max-width: 62ch;
  }

  .todo {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .14em;
    padding: 2px 6px;
    border: 1px dashed var(--muted);
    border-radius: var(--radius);
  }
</style>
