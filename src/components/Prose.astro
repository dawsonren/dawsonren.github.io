---
/** Typographic wrapper for long-form Markdown: case studies and writing. */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
  }

  .prose > :global(* + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 2.2em;
  }

  .prose :global(h3) {
    margin-top: 1.8em;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.6em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: var(--s-5);
    border-left: 2px solid var(--rule);
    color: var(--muted);
  }

  .prose :global(pre) {
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface) !important;
    font-size: 0.9375rem;
    line-height: 1.5;
    overflow-x: auto;
  }

  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }

  .prose :global(img) {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
</style>
